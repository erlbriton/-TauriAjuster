{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-ajuster",
  "version": "0.1.0",
  "identifier": "com.erlbriton.tauri-ajuster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tauri-ajuster",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Capability for the main window to access fs and dialog",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "dialog:default",
            {
              "identifier": "fs:allow-write-file",
              "allow": [
                { "path": "**" }
              ]
            },
            {
              "identifier": "fs:allow-read-file",
              "allow": [
                { "path": "**" }
              ]
            },
            "fs:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}